generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramUserId   BigInt    @unique @map("telegram_user_id")
  telegramUsername String?   @map("telegram_username")
  tier             String    @default("free")
  tierExpiresAt    DateTime? @map("tier_expires_at") @db.Timestamptz(6)
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  starChargeId     String?   @map("star_charge_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  githubInstallations GithubInstallation[]
  repos               Repo[]
  researchRuns        ResearchRun[]
  usageCounters       UsageCounter[]
  checkoutSessions    CheckoutSession[]
  payments            Payment[]

  @@map("users")
}

model CheckoutSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  plan        String
  stars       Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]

  @@map("checkout_sessions")
}

model Payment {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  checkoutSessionId       String    @map("checkout_session_id") @db.Uuid
  telegramPaymentChargeId String    @unique @map("telegram_payment_charge_id")
  providerPaymentChargeId String    @default("") @map("provider_payment_charge_id")
  currency                String
  stars                   Int
  plan                    String
  isRecurring             Boolean   @default(false) @map("is_recurring")
  isFirstRecurring        Boolean   @default(false) @map("is_first_recurring")
  subscriptionExpiresAt   DateTime? @map("subscription_expires_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id])
  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])

  @@map("payments")
}

model GithubInstallation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  installationId BigInt   @map("installation_id")
  githubAccount  String   @map("github_account")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id])
  repos Repo[]

  @@map("github_installations")
}

model Repo {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  installationId   String   @map("installation_id") @db.Uuid
  fullName         String   @map("full_name")
  defaultBranch    String   @default("main") @map("default_branch")
  stackFingerprint Json?    @map("stack_fingerprint")
  checkFrequency   String   @default("daily") @map("check_frequency")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User               @relation(fields: [userId], references: [id])
  installation GithubInstallation @relation(fields: [installationId], references: [id])
  dailyRuns    DailyRun[]
  researchRuns ResearchRun[]

  @@unique([userId, fullName])
  @@map("repos")
}

model DailyRun {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repoId      String   @map("repo_id") @db.Uuid
  ranAt       DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)
  findings    Json
  summarySent Boolean  @default(false) @map("summary_sent")

  repo Repo @relation(fields: [repoId], references: [id])

  @@map("daily_runs")
}

model ResearchRun {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repoId      String   @map("repo_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  command     String
  inputParams Json?    @map("input_params")
  resultText  String?  @map("result_text")
  tokensUsed  Int?     @map("tokens_used")
  ranAt       DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)

  repo Repo @relation(fields: [repoId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("research_runs")
}

model UsageCounter {
  userId           String   @map("user_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Date
  deepResearchUsed Int      @default(0) @map("deep_research_used")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, periodStart])
  @@map("usage_counters")
}
